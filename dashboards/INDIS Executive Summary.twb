                <zone forceUpdate='true' h='3598' id='17' type-v2='text' w='6234' x='85536' y='16998'>
                  <formatted-text>
                    <run fontname='Tableau Regular' fontsize='12'>99,7%</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
